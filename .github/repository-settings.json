{
  "repository": "kggayo/goddard",
  "description": "Your coding agent's best friend. Save progress, switch available accounts, and hand unfinished work to the next agent.",
  "settings": {
    "has_issues": true,
    "has_discussions": true,
    "has_wiki": false,
    "has_projects": false,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": true,
    "allow_update_branch": true,
    "default_branch": "main"
  },
  "topics": ["cli", "coding-agent", "codex", "claude-code", "handoff", "checkpoint", "open-source", "developer-tools"],
  "protection": {
    "required_status_checks": {
      "strict": true,
      "contexts": ["Test (ubuntu-latest)", "Test (windows-latest)", "Test (macos-latest)"]
    },
    "enforce_admins": true,
    "required_pull_request_reviews": {
      "dismiss_stale_reviews": true,
      "required_approving_review_count": 0
    },
    "restrictions": null,
    "required_linear_history": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "required_conversation_resolution": true
  },
  "labels": [
    { "name": "bug", "color": "d73a4a", "description": "Something isn't working as expected" },
    { "name": "enhancement", "color": "a2eeef", "description": "A useful improvement or new capability" },
    { "name": "documentation", "color": "0075ca", "description": "Make getting started and contributing clearer" },
    { "name": "good first issue", "color": "7057ff", "description": "A focused, approachable starting point for a new contributor" },
    { "name": "help wanted", "color": "008672", "description": "Community input or implementation welcome" },
    { "name": "provider-adapter", "color": "f9d0c4", "description": "Coding-agent integration research and implementation" }
  ]
}
