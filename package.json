{
  "name": "goddard",
  "version": "0.3.0",
  "description": "Your coding agent's best friend: saved progress, account failover, and durable handoffs",
  "homepage": "https://github.com/kggayo/goddard#readme",
  "repository": { "type": "git", "url": "git+https://github.com/kggayo/goddard.git" },
  "bugs": { "url": "https://github.com/kggayo/goddard/issues" },
  "keywords": ["coding-agent", "codex", "claude-code", "handoff", "cli", "checkpoint"],
  "type": "module",
  "bin": {
    "goddard": "bin/goddard.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/goddard.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "demo": "node scripts/demo.js",
    "preview": "node scripts/preview.js",
    "github:publish": "node scripts/publish-github.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "docs/usage.md",
    "LICENSE"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "highlight.js": "11.12.0",
    "marked": "18.1.0",
    "string-width": "8.3.0",
    "wrap-ansi": "10.0.2"
  }
}
